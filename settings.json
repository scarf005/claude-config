{
  "cleanupPeriodDays": 14,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_FORCE_TERMINAL_IMAGES": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(ls:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gio trash:*)",
      "Bash(git gtr clean:*)",
      "EnterWorktree"
    ],
    "deny": [
      "Bash(rm:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/pi/agent/auth.json)",
      "Read(~/.config/claude-2/.credentials.json)",
      "Bash(grep:*)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "grill-me": "off"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '{\"소 \":\"sonnet\",\"하 \":\"haiku\"}[(.prompt // \"\")[0:2]] | select(.) | {hookSpecificOutput:{hookEventName:\"UserPromptSubmit\",additionalContext:\"The prompt starts with a model prefix: do its task through an Agent call with model \\(.) instead of in the main session. The prefix is not part of the task. Ignore this when the rest is no task, such as a sigh.\"}}'",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/pi/bin/agent-notify.py\" claude",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/pi/bin/agent-notify.py\" claude",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/claude/hooks/korean_reply.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"allow\"}}}'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/claude/hooks/pre_compact_snapshot.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/claude/hooks/post_compact_restore.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/claude/hooks/random_persona.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "assisted-by@assisted-by-local": true,
    "raster-view@local-mods": true,
    "frontend-design@claude-plugins-official": false,
    "cloudflare@cloudflare": false
  },
  "extraKnownMarketplaces": {
    "local-mods": {
      "source": {
        "source": "directory",
        "path": "/home/scarf/.config/claude/mods"
      }
    },
    "assisted-by-local": {
      "source": {
        "source": "directory",
        "path": "/home/scarf/repo/assisted-by"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "cc-stretch": {
      "source": {
        "source": "github",
        "repo": "pro-vi/cc-stretch"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "working"
    ]
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 400000
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 400000
    },
    "claude-haiku-5-5": {
      "autoCompactWindow": 160000
    },
    "claude-fable-5-1": {
      "effortLevel": "medium",
      "autoCompactWindow": 400000
    }
  },
  "tui": "fullscreen",
  "prefersReducedMotion": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public — this repo has no configured git remotes, so treat it as local-only until a remote is added",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: unknown — no git remote configured and gh visibility check not queryable (origin/HEAD unset, no remotes)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo (local checkout at /home/scarf/repo/etc/hypha) — no remotes configured, no additional orgs",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (Godot game development — Hypha, a tank shooter project)",
      "**Trusted repo**: /home/scarf/repo/etc/hypha (local checkout, no configured remotes)",
      "**Org-specific CLIs**: None configured — project uses godot, xvfb-run, ffmpeg routinely per usage evidence"
    ]
  }
}
